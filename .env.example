# ─── Base de données (obligatoire pour le contrôle d'accès et la banque) ─────
# Chaîne PostgreSQL standard. Lue en premier ; POSTGRES_URL (Vercel) en repli.
#   Render   : DATABASE_URL du service Postgres (interne ou externe)
#   Supabase : chaîne « Session pooler », port 5432
#   Neon     : chaîne pooled ; sur Vercel, POSTGRES_URL est posée automatiquement
#   Local    : postgres://formation:formation@localhost:5432/formation
DATABASE_URL=

# TLS vers la base : disable | require | verify
#   défaut : disable si l'hôte est local, require sinon
#   require : chiffre sans vérifier l'autorité (autorité privée Supabase acceptée)
#   verify  : vérifie la chaîne avec DATABASE_SSL_CA (PEM inline) ou DATABASE_SSL_CA_FILE
# DATABASE_SSL=require
# DATABASE_SSL_CA_FILE=/etc/secrets/prod-ca-2021.crt

# ─── Secret des sessions et des sceaux (obligatoire) ─────────────────────────
# openssl rand -base64 32
AUTH_SECRET=

# ─── Stockage des documents déposés ───────────────────────────────────────────
# Facultatif : sans jeton, les fichiers sont conservés dans la base (table
# `fichiers`, 15 Mo par fichier au plus). Avec le jeton, Vercel Blob est utilisé.
# BLOB_READ_WRITE_TOKEN=

# ─── Conservation des rapports d'évaluation ───────────────────────────────────
# aucune (défaut) : rapport construit sur le poste, signé sur papier, rien
#                   de nominatif enregistré.
# nominative      : rapports émis enregistrés avec le nom saisi, numérotés,
#                   scellés, circuit de visas tuteur → pharmacien. Suppose une
#                   inscription au registre des traitements et une durée de
#                   conservation décidée — [à préciser].
CONSERVATION_RAPPORTS=aucune
# Durée de conservation annoncée sur les rapports, en mois — [à préciser]
# RAPPORTS_CONSERVATION_MOIS=

# ─── Divers ───────────────────────────────────────────────────────────────────
# Taille du pool de connexions (5 par défaut ; 2 ou 3 sur un plan gratuit)
# DATABASE_POOL_MAX=5
